# Inventory mode:
# - fixture: deterministic local demo inventory only
# - hybrid: live providers with configured keys, fixture fallback for the rest
# - live: live providers only
INVENTORY_MODE=fixture
PORT=4180
REFRESH_INTERVAL_SECONDS=5

# Backend crawl loop cadence. `REFRESH_INTERVAL_SECONDS` is the rest between
# completed crawl cycles; provider-specific values control how often an API is
# actually called. Example: PROVIDER_REFRESH_SECONDS_VAST_AI=15
PROVIDER_REFRESH_SECONDS_DEFAULT=

# Live vendor validation timeout. Progress logs are written to stderr and the
# final machine-readable report is written to stdout.
VALIDATE_VENDOR_TIMEOUT_MS=90000

# Optional last-known-good inventory snapshots. Use `file` locally and `gcs`
# on Cloud Run so fresh instances do not show an empty table while crawling.
INVENTORY_SNAPSHOT_STORE=off
INVENTORY_SNAPSHOT_FILE=.cache/inventory-snapshot.json
INVENTORY_SNAPSHOT_GCS_BUCKET=
INVENTORY_SNAPSHOT_GCS_OBJECT=inventory/latest.json
INVENTORY_SNAPSHOT_TIMEOUT_MS=5000

