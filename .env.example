TAIGA_ENABLED=
TAIGA_PRICING_URL=
TAIGA_TIMEOUT_MS=30000
# Yotta Labs (on-demand GPU cloud): no public pricing API; per-GPU on-demand hourly USD prices
# scraped from the public pricing table (spot column dropped). Non-orderable. Opt-in.
YOTTALABS_ENABLED=
YOTTALABS_PRICING_URL=
YOTTALABS_TIMEOUT_MS=30000
# FarmGPU (bare-metal H100/B200 clusters): no public pricing API; per-GPU hourly USD prices
# scraped from the public pricing page cards (8x H100 80GB SXM, 8x B200 192GB). Non-orderable. Opt-in.
FARMGPU_ENABLED=
FARMGPU_PRICING_URL=
FARMGPU_TIMEOUT_MS=30000
# Ola Krutrim (Indian GPU cloud): no public pricing API; per-instance on-demand INR/hr GPU
# prices (A100/H100) scraped from the public pricing tables (INR->USD via core FX; fractional
# MIG/CPU rows skipped). Non-orderable. Opt-in.
OLAKRUTRIM_ENABLED=
OLAKRUTRIM_PRICING_URL=
OLAKRUTRIM_TIMEOUT_MS=30000
# Zoner (zonercloud.com GPU servers): no public pricing API; per-GPU hourly USD rates
# (RTX 4090/5090/PRO 6000/H200 NVL) parsed from the embedded configurator JS price table.
# Non-orderable. Opt-in.
ZONER_ENABLED=
ZONER_PRICING_URL=
ZONER_TIMEOUT_MS=30000
# NeevCloud (Indian AI GPU cloud): the marketing site is Cloudflare-walled, but the official
# API gateway api.ai.neevcloud.com is reachable and returns a priced, capacity-aware GPU
# inventory (per-GPU hourly USD + live available_gpu_count). Requires a Bearer token: a
# pat-nc-* personal access token (or the console-login access_token JWT). The inference
# sk-nc-* keys are REJECTED here. Non-orderable (provisioning is an API mutation). Set the key:
NEEVCLOUD_API_KEY=
# NEEVCLOUD_PAT= / NEEVCLOUD_TOKEN= are accepted aliases for the same token.
NEEVCLOUD_API_BASE_URL=
NEEVCLOUD_TIMEOUT_MS=30000

# --- "Real companies" pass (2026-06-14): getDeploying aggregator + 4 GPU clouds rescued from
#     the former "unidentifiable" Tier E bucket. All non-orderable catalogs; none needs a key. ---
# getDeploying (getdeploying.com): GPU price-comparison aggregator/meta-source. Scrapes the
# public reference pages (model index + per-model detail) for per-provider ON_DEMAND $/GPU/hr
# (spot/reserved dropped). To stay light it expands only the top-N mainstream models by provider
# count. Non-orderable cross-check catalog (providers overlap with direct integrations). Opt-in.
GETDEPLOYING_ENABLED=
GETDEPLOYING_BASE_URL=
GETDEPLOYING_MAX_MODELS=12
# GETDEPLOYING_MODELS= optional comma-separated slug allowlist (e.g. nvidia-h100,nvidia-a100)
# to override the top-N selection.
GETDEPLOYING_MODELS=
GETDEPLOYING_TIMEOUT_MS=30000
# Nebula Block (nebulablock.com): public no-auth JSON API. Whole-instance hourly USD (per-GPU =
# price/gpu_count) with live stock/is_available across CA/US/FI/FR/NO; spot rows dropped.
# Non-orderable (console + funded wallet to provision). Opt-in, no key.
NEBULABLOCK_ENABLED=
NEBULABLOCK_API_URL=
NEBULABLOCK_TIMEOUT_MS=30000
# Trainy (trainy.ai): single on-demand 8xH100 per-GPU/hr SKU scraped from the public pricing
# page (reserved is contact-sales). Non-orderable. Opt-in.
TRAINY_ENABLED=
TRAINY_PRICING_URL=
TRAINY_TIMEOUT_MS=30000
# Turboscale (turboscale.com): whole-config hourly USD GPU prices (H100/A100/V100, incl.
# storage tiers) scraped from the public pricing table; per-GPU = price/count. Non-orderable. Opt-in.
TURBOSCALE_ENABLED=
TURBOSCALE_PRICING_URL=
TURBOSCALE_TIMEOUT_MS=30000
# Visionbay (visionbay.ai): Foxconn GPU cloud. Per-GPU hourly USD rates (H100/B300/GB200/GB300)
# scraped from the public pricing cards (model read from the card description). Non-orderable. Opt-in.
VISIONBAY_ENABLED=
VISIONBAY_PRICING_URL=
VISIONBAY_TIMEOUT_MS=30000


