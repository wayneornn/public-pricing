# Akamai (Linode): the instance-type catalog is a public endpoint, so set
# LINODE_ENABLED=1 to crawl it without a token, or supply LINODE_TOKEN for an
# authenticated read.
LINODE_ENABLED=
LINODE_TOKEN=
# Civo: free-signup API key (dashboard.civo.com → Settings → Security). The /v2/sizes
# GPU catalog is unpriced, so Civo rows surface specs + region availability only.
CIVO_API_KEY=
# Novita AI: free-signup API key (novita.ai → Settings → Key Management). Surfaces
# on-demand GPU product prices + inventory state (spot pricing is excluded).
NOVITA_API_KEY=
# Oblivus: API key from console.oblivus.com (API -> Credentials). Auth is the `apiKey`
# header. Exposes per-GPU price + per-location deployable stock counts.
OBLIVUS_API_KEY=
# LeaderGPU (api.leaderssl.com): account email + password (no API-key option). The
# connector signs in and reads the EUR-priced bare-metal GPU server catalog.
LEADERGPU_LOGIN=
LEADERGPU_PASSWORD=
# Thunder Compute: public pricing/specs API, no key. Set THUNDERCOMPUTE_ENABLED=1 to crawl.
THUNDERCOMPUTE_ENABLED=
# Outscale: ReadPublicCatalog is public (no key). Set OUTSCALE_ENABLED=1 to crawl the
# Flexible GPU price catalog across regions (override regions with OUTSCALE_REGIONS).
OUTSCALE_ENABLED=
OUTSCALE_REGIONS=
# Atlantic.Net: GPU SKUs + on-demand hourly prices are scraped from the GPU cloud page's
# schema.org JSON-LD (the legacy signature-auth CloudAPI lists no GPU plans). Opt-in.
ATLANTICNET_ENABLED=
# gpulist.ai: community GPU listings board (brokered reservation offers). No API — approved
# listings are scraped from the landing page's Next.js RSC payload. Non-orderable. Opt-in.
GPULIST_ENABLED=
# leafcloud: no pricing API — prices are scraped from its public pricing page. Opt-in.
LEAFCLOUD_ENABLED=
# Seeweb: no pricing API — prices are scraped from its product page. Opt-in.
SEEWEB_ENABLED=
# SaladCloud: free API key (portal.salad.com → API Access) + your organization name.
SALAD_API_KEY=
SALAD_ORG=
# Jarvis Labs: API key from the dashboard. Exposes per-GPU INR price + free-device counts.
JARVISLABS_API_KEY=
# Hydra Host: Brokkr marketplace pricing/availability is public (no key). Set HYDRA_ENABLED=1.
HYDRA_ENABLED=
# SAKURA internet: 高火力 VRT price-list API is public (no key). Set SAKURA_ENABLED=1 to crawl.
# Optional SAKURA_ZONES (CSV, default is1a,is1b) to override which zones are queried.
SAKURA_ENABLED=
# IONOS Cloud: H200 GPU VM prices come from the public price calculator (no key). Set IONOS_ENABLED=1.
IONOS_ENABLED=
# Sharon AI: compute-profile catalog (Rafay PaaS API) lists GPU SKUs with hourly AUD
# prices. Needs an API key (starts "ra2.") from portal.sharonai.cloud → Compute →
# My Tools → API & Registry Keys. Optional SHARONAI_PROJECT (default "defaultproject").
SHARONAI_API_KEY=
# Exabits: GPU flavors REST API needs an API Token (generate in the Exabits console).
EXABITS_API_TOKEN=
# Alias accepted by the connector if your credential is named as an API key.
EXABITS_API_KEY=
# Denvr Dataworks / Denvr AI Cloud: VM configuration + availability API.
# Prefer a temporary bearer token, or set username/email + password for token auth.
DENVR_ACCESS_TOKEN=
DENVR_USERNAME=
DENVR_EMAIL=
DENVR_PASSWORD=
# Optional CSV filters. Defaults to all allocated clusters and the on-demand resource pool.
DENVR_CLUSTERS=
DENVR_RESOURCE_POOLS=on-demand
# Contabo GPU Cloud: public monthly-price/spec table scrape. Non-orderable. Opt-in.
CONTABO_ENABLED=
# Hetzner GEX dedicated GPU servers: public Robot availability/price endpoint. Non-orderable. Opt-in.
HETZNER_ENABLED=
# Utho GPU Cloud: public GPU page bundle has monthly INR price/specs. Non-orderable. Opt-in.
UTHO_ENABLED=
UTHO_GPU_URL=
UTHO_TIMEOUT_MS=
# GreenNode/VNG GPU Cloud: public H100 pricing page CMS state/table. Non-orderable. Opt-in.
GREENNODE_ENABLED=
GREENNODE_PRICING_URL=
GREENNODE_TIMEOUT_MS=
# ACE Cloud GPU: official public pricing pages; OpenStack APIs are auth/project-gated. Non-orderable. Opt-in.
ACECLOUD_ENABLED=
ACECLOUD_BASE_URL=
ACECLOUD_GPU_SLUGS=
ACECLOUD_REGIONS=
ACECLOUD_TIMEOUT_MS=
# Arkane Cloud GPU: official public pricing table; compute API is auth-gated and no public stock endpoint is documented. Non-orderable. Opt-in.
ARKANE_ENABLED=
ARKANE_PRICING_URL=
ARKANE_TIMEOUT_MS=
# Backprop GPU Cloud: official public pricing table scrape; no public catalog/stock API found. Non-orderable. Opt-in.
BACKPROP_ENABLED=
BACKPROP_PRICING_URL=
BACKPROP_TIMEOUT_MS=
# Hot Aisle (AMD MI300X): public team API added for the dstack `hotaisle` backend.
# Requires BOTH an API key (Authorization: Token <key>) and your team handle (URL path).
# Generate via `ssh admin.hotaisle.app` -> team -> API key. Real creatable/reservable
# Quantity + whole-instance hourly USD, but deploy is mutating, so non-orderable.
HOTAISLE_API_KEY=
HOTAISLE_TEAM_HANDLE=
HOTAISLE_REGION=
HOTAISLE_API_BASE_URL=
HOTAISLE_CONSOLE_URL=
HOTAISLE_TIMEOUT_MS=30000
# HPC-AI.com (HPC-AI Tech / Colossal cloud): no public pricing API (documented REST API is
# JWT-login-gated, instance create/list/stop only). On-demand per-GPU/hr USD is scraped from
# the public /gpus/<model> pages (H200, B200; spot dropped; B300 is "Contact"). Non-orderable. Opt-in.
HPCAI_ENABLED=
HPCAI_GPU_SLUGS=
HPCAI_BASE_URL=
HPCAI_TIMEOUT_MS=30000
# Northflank (GPU PaaS): public API exposes only CPU compute plans + an unpriced hardware
# catalog. All-inclusive managed GPU per-GPU/hr USD is scraped from the public pricing page
# cards (L4, A100 40/80, H100 80, RTX PRO 6000). Non-orderable (deploy platform). Opt-in.
NORTHFLANK_ENABLED=
NORTHFLANK_PRICING_URL=
NORTHFLANK_TIMEOUT_MS=30000
# Hivenet (Compute with Hivenet): public presets/pricing API (api.hivecompute.ai), no key.
# RTX 4090/5090 per-preset hourly EUR prices + specs + location; €0 demo presets dropped.
# Non-orderable (no live capacity). Opt-in so default/offline runs make no network call.
HIVENET_ENABLED=
HIVENET_API_URL=
HIVENET_CONSOLE_URL=
HIVENET_TIMEOUT_MS=30000
# ionstream.ai (bare-metal GPU): marketing site, no public pricing API. Per-GPU
# "Pricing starts at $X p/hr" floors (L40S/H200/B200) scraped from the homepage solution
# cards (starting/from price; reserved/spot tiers not captured). Non-orderable. Opt-in.
IONSTREAM_ENABLED=
IONSTREAM_HOME_URL=
IONSTREAM_TIMEOUT_MS=30000
# io.net (IO Cloud, decentralized GPU network): public no-key hardware API
# (api.io.solutions/v1/io-cloud/vmaas|caas/hardware). Whole-config hourly USD price +
# specs + location + deployable available_replicas; per-GPU = price/num_cards.
# Non-orderable (console + funded wallet to deploy). Opt-in.
IONET_ENABLED=
IONET_API_BASE_URL=
IONET_CONSOLE_URL=
IONET_TIMEOUT_MS=30000
# CoreWeave (Kubernetes-native GPU cloud): no public pricing API; per-instance On-Demand
# hourly USD prices (+ GPU Count, VRAM) scraped from the public pricing page cards
# (spot/inference rows dropped; per-GPU = On-Demand/GPU Count). Non-orderable. Opt-in.
COREWEAVE_ENABLED=
COREWEAVE_PRICING_URL=
COREWEAVE_TIMEOUT_MS=30000
# LiquidWeb (managed GPU hosting): no public pricing API (schema.org block carries only an
# aggregate 'from' price); per-config discounted hourly USD prices (model + VRAM + optional
# GPU count) scraped from the public GPU hosting page cards. Non-orderable. Opt-in.
LIQUIDWEB_ENABLED=
LIQUIDWEB_PRICING_URL=
LIQUIDWEB_TIMEOUT_MS=30000
# Qubrid AI (on-demand GPU cloud): no public pricing API; on-demand catalog (per-config
# hourly USD price + specs + availability flag) scraped from the embedded JS on the public
# pricing page (per-GPU = amount/gpuCount; quote-only 8-GPU servers ignored). Non-orderable. Opt-in.
QUBRID_ENABLED=
QUBRID_PRICING_URL=
QUBRID_TIMEOUT_MS=30000
# Core42 (G42 AI cloud): pay-as-you-go is console-signup only with no public pricing API;
# per-GPU 'From $X/hr' starting floors (H100/H200/B200/MI300X) scraped from the public AI
# Cloud product page cards ('On Request' SKUs dropped). Non-orderable. Opt-in.
CORE42_ENABLED=
CORE42_PRICING_URL=
CORE42_TIMEOUT_MS=30000
# FlexAI (cross-cloud orchestration): per-GPU on-demand hourly USD prices scraped from the
# public pricing page's schema.org Offer objects (secondary spot/reserved column dropped).
# Non-orderable. Opt-in.
FLEXAI_ENABLED=
FLEXAI_PRICING_URL=
FLEXAI_TIMEOUT_MS=30000
# Valdi (valdi.ai, pay-as-you-go GPU): no public provisioning/pricing API; per-GPU
# 'Starting at $X/hr' floors scraped from the public home page cards. Non-orderable. Opt-in.
VALDI_ENABLED=
VALDI_HOME_URL=
VALDI_TIMEOUT_MS=30000

